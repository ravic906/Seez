<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Echoes is always dark: deep space behind the game, the status and navigation bars. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#05060F</item>
        <item name="colorPrimaryDark">#05060F</item>
        <item name="colorAccent">#4FD8FF</item>
        <item name="android:windowBackground">@color/space</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/space</item>
        <item name="android:statusBarColor">@color/space</item>
        <item name="android:navigationBarColor">@color/space</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Launch: the system splash (Android 12+) shows the bot on deep space; older phones show splash.png. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/space</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
